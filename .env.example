# Postgres
POSTGRES_USER=minihive
POSTGRES_PASSWORD=password
POSTGRES_DB=name
DATABASE_URL=postgres://minihive:password@localhost:5434/name

# AWS
AWS_REGION=eu-west-1
AWS_PROFILE=minihive
# TopicArn output of the MinihiveProvisioning stack
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:provisioning-events

# Cognito
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=https://minihive-xxxxxxxxxxxx.auth.eu-west-1.amazoncognito.com

# Password for all seed users. Must have 8+ chars, upper, lower, number and symbol.
SEED_USER_PASSWORD=Change-me-123
