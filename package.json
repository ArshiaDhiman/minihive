{
  "name": "minihive",
  "version": "1.0.0",
  "description": "Multi-tenant user, licence and seat management platform. Amazon Cognito auth, role- and policy-based permissions, PostgreSQL with PL/pgSQL auditing, and event-driven provisioning via outbox → SNS → SQS → Lambda → DynamoDB. NestJS, React, TypeScript, AWS CDK.",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "node --env-file=.env infra/db/migrate.ts",
    "db:seed": "node --env-file=.env infra/db/seed.ts",
    "cdk": "npm exec -w infra/cdk -- cdk",
    "db:seed-users": "node --env-file=.env infra/scripts/seed-cognito-users.ts"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/worker",
    "infra/cdk"
  ],
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "pg": "^8.23.1"
  }
}
